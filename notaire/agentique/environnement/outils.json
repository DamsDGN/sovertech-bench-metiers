[
  {
    "type": "function",
    "function": {
      "name": "rechercher",
      "description": "Cherche des documents de l'étude à partir de mots-clés. Renvoie une liste de documents (identifiant, titre, statut, extrait).",
      "parameters": {
        "type": "object",
        "properties": {
          "requete": {
            "type": "string",
            "description": "Mots-clés de la recherche"
          }
        },
        "required": [
          "requete"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lire",
      "description": "Lit le texte complet d'un document de l'étude à partir de son identifiant.",
      "parameters": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "description": "Identifiant du document"
          }
        },
        "required": [
          "doc_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "extraire_champs",
      "description": "Extrait des champs précis d'un document, depuis son en-tête et les lignes de ses tableaux à deux colonnes (libellé, valeur) (par exemple la date de signature prévue d'une fiche de dossier).",
      "parameters": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "description": "Identifiant du document"
          },
          "champs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Noms des champs à extraire"
          }
        },
        "required": [
          "doc_id",
          "champs"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "lire_tableau",
