        "properties": {
          "tableau": {
            "type": "string",
            "description": "Nom du tableau"
          }
        },
        "required": [
          "tableau"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ecrire_tableau",
